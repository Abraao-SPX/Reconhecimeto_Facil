{
  "expo": {
    "name": "Reconhecimento Fácil",
    "slug": "reconhecimento-facil",
    "version": "1.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "O aplicativo precisa da câmera para verificar sua identidade com segurança e evitar fraudes.",
          "microphonePermission": "Permite acesso ao sensor de vídeo durante a prova de vida."
        }
      ],
      [
        "expo-brightness",
        {
          "brightnessPermission": "Permite ajustar o brilho durante o teste de prova de vida."
        }
      ]
    ],
    "android": {
      "package": "com.abraao.reconhecimentofacil",
      "versionCode": 2,
      "adaptiveIcon": {
        "backgroundColor": "#0F172A",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.INTERNET",
        "android.permission.WRITE_SETTINGS"
      ]
    },
    "ios": {
      "infoPlist": {
        "NSCameraUsageDescription": "A câmera é necessária para verificar sua identidade com segurança e evitar perfis falsos."
      }
    },
    "extra": {
      "eas": {
        "projectId": "a3ac5a95-b43a-4923-8cb2-74a459932ef0"
      }
    },
    "owner": "abraao1098"
  }
}
